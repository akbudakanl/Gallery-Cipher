<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/vault_security_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/normal_margin">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/vault_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/normal_margin"
        app:tabGravity="fill"
        app:tabMode="fixed" />

    <org.fossify.commons.views.MyTextView
        android:id="@+id/vault_status_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/normal_margin"
        android:gravity="center"
        android:textSize="@dimen/bigger_text_size" />

    <!-- Pattern View (PROTECTION_PATTERN = 0) -->
    <FrameLayout
        android:id="@+id/vault_pattern_holder"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:visibility="gone">

        <org.fossify.gallery.views.VaultPatternView
            android:id="@+id/vault_pattern_view"
            android:layout_width="250dp"
            android:layout_height="250dp"
            android:layout_gravity="center" />
    </FrameLayout>

    <!-- PIN Pad View (PROTECTION_PIN = 1) -->
    <LinearLayout
        android:id="@+id/vault_pin_holder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <org.fossify.commons.views.MyTextView
            android:id="@+id/vault_pin_dots"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center"
            android:letterSpacing="0.3"
            android:textSize="24sp" />

        <GridLayout
            android:id="@+id/vault_pin_grid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alignmentMode="alignBounds"
            android:columnCount="3"
            android:rowCount="4"
            android:useDefaultMargins="true">

            <org.fossify.commons.views.MyButton
                android:id="@+id/pin_1"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="72dp"
                android:layout_height="56dp"
                android:text="1"
                android:textSize="20sp" />

            <org.fossify.commons.views.MyButton
                android:id="@+id/pin_2"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="72dp"
                android:layout_height="56dp"
                android:text="2"
                android:textSize="20sp" />

            <org.fossify.commons.views.MyButton
                android:id="@+id/pin_3"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="72dp"
                android:layout_height="56dp"
                android:text="3"
                android:textSize="20sp" />

            <org.fossify.commons.views.MyButton
                android:id="@+id/pin_4"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="72dp"
                android:layout_height="56dp"
                android:text="4"
                android:textSize="20sp" />

            <org.fossify.commons.views.MyButton
                android:id="@+id/pin_5"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="72dp"
                android:layout_height="56dp"
                android:text="5"
                android:textSize="20sp" />

            <org.fossify.commons.views.MyButton
                android:id="@+id/pin_6"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="72dp"
                android:layout_height="56dp"
                android:text="6"
                android:textSize="20sp" />

            <org.fossify.commons.views.MyButton
                android:id="@+id/pin_7"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="72dp"
                android:layout_height="56dp"
                android:text="7"
                android:textSize="20sp" />

            <org.fossify.commons.views.MyButton
                android:id="@+id/pin_8"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="72dp"
                android:layout_height="56dp"
                android:text="8"
                android:textSize="20sp" />

            <org.fossify.commons.views.MyButton
                android:id="@+id/pin_9"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="72dp"
                android:layout_height="56dp"
                android:text="9"
                android:textSize="20sp" />

            <org.fossify.commons.views.MyButton
                android:id="@+id/pin_backspace"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="72dp"
                android:layout_height="56dp"
                android:text="⌫"
                android:textSize="20sp" />

            <org.fossify.commons.views.MyButton
                android:id="@+id/pin_0"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="72dp"
                android:layout_height="56dp"
                android:text="0"
                android:textSize="20sp" />

            <org.fossify.commons.views.MyButton
                android:id="@+id/pin_ok"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="72dp"
                android:layout_height="56dp"
                android:text="✓"
                android:textSize="22sp" />
        </GridLayout>
    </LinearLayout>

    <!-- Full Alphanumeric Password View (PROTECTION_PASSWORD = 3) -->
    <LinearLayout
        android:id="@+id/vault_password_holder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/vault_password_input_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/vault_password_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                android:maxLines="1"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <org.fossify.commons.views.MyButton
            android:id="@+id/vault_password_ok_btn"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="@dimen/small_margin"
            android:text="✓"
            android:textSize="22sp" />
    </LinearLayout>

</LinearLayout>
