<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialog_delete_cipher_secrets_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/activity_margin">

    <org.fossify.commons.views.MyTextView
        android:id="@+id/cipher_secrets_warning_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="@dimen/small_margin"
        android:paddingBottom="@dimen/medium_margin"
        android:text="@string/delete_and_recreate_cipher_secrets_prompt"
        android:textSize="@dimen/bigger_text_size" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cipher_secrets_confirm_checkbox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/activity_margin"
        android:enabled="false"
        android:text="@string/confirm_checkbox_label"
        android:textSize="@dimen/normal_text_size" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cipher_secrets_btn_yes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/small_margin"
            android:enabled="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cipher_secrets_btn_no"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/small_margin" />
    </LinearLayout>

</LinearLayout>
