<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/vault_exit_scrollview"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/vault_exit_holder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="@dimen/activity_margin"
        android:paddingTop="@dimen/activity_margin"
        android:paddingRight="@dimen/activity_margin">

        <org.fossify.commons.views.MyTextView
            android:id="@+id/vault_exit_question"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/small_margin"
            android:paddingBottom="@dimen/medium_margin"
            android:textSize="@dimen/normal_text_size" />

        <include
            android:id="@+id/vault_exit_divider"
            layout="@layout/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/small_margin"
            android:layout_marginBottom="@dimen/medium_margin" />

        <org.fossify.commons.views.MyAppCompatCheckbox
            android:id="@+id/vault_exit_always_ask_checkbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="false"
            android:text="@string/on_vault_exit_ask_every_time" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/vault_exit_settings_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/small_margin"
            android:paddingStart="@dimen/small_margin"
            android:paddingEnd="@dimen/small_margin"
            android:paddingBottom="@dimen/small_margin"
            android:text="@string/vault_exit_settings_hint"
            android:textSize="@dimen/smaller_text_size"
            android:alpha="0.75" />

    </LinearLayout>

</ScrollView>
